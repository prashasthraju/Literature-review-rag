    {
      "figure_number": 1,
      "path": "/home/hp/btp_avatar/Literature-review-rag/parsed/text_driven_generation/Instructavatar/images/figure_001.png",
      "caption": "Fig. 1: InstructAvatar enables emotional talking face generation through a flexible natural language interface (top 2 rows). The generated results exhibit fine-grained expression control, excellent identity preservation, high-quality lip sync, and natural character movements. Moreover, it supports direct control of facial motion and expression without relying on audio cues, a feature absent in previous studies (bottom 2 rows). The ability of InstructAvatar to handle highly out-of-domain appearances (like cartoons, sketches, and sculptures) further highlights its generalization capabilities.",
      "provenance": [
        {
          "page_no": 1,
          "bbox": {
            "l": 152.82138061523438,
            "t": 509.0003662109375,
            "r": 460.3993835449219,
            "b": 214.3057861328125,
            "coord_origin": "BOTTOMLEFT"
          },
          "charspan": [
            0,
            0
          ]
        }
      ]
    },
    {
      "figure_number": 2,
      "path": "/home/hp/btp_avatar/Literature-review-rag/parsed/text_driven_generation/Instructavatar/images/figure_002.png",
      "caption": "Fig. 2: Method Overview: The InstructAvatar consists of two components: VAE H to disentangle motion information from the video and a motion generator G to generate the motion latent conditioned on audio and instruction. As we have two types of data, two switches in instruction and audio are designed. During inference, the motion encoder in the VAE will be dropped and we iteratively denoise Gaussian noise to obtain the predicted motion latent. Together with the user-provided portrait, the resulting video is generated by the decoder of the VAE.",
      "provenance": [
        {
          "page_no": 5,
          "bbox": {
            "l": 135.8693084716797,
            "t": 675.2174530029297,
            "r": 479.0260925292969,
            "b": 534.6398620605469,
            "coord_origin": "BOTTOMLEFT"
          },
          "charspan": [
            0,
            0
          ]
        }
      ]
    },
    {
      "figure_number": 3,
      "path": "/home/hp/btp_avatar/Literature-review-rag/parsed/text_driven_generation/Instructavatar/images/figure_003.png",
      "caption": "Fig. 3: We extend the emotion label using a predefined template and incorporate intensity information by modifying the emotion with an adverb representing the degree. For fine-grained control, we extract the AUs and then prompt GPT-4V to paraphrase them into a sentence.",
      "provenance": [
        {
          "page_no": 6,
          "bbox": {
            "l": 135.8462371826172,
            "t": 673.6183776855469,
            "r": 494.2295227050781,
